{
  "name": "gospel-focus",
  "version": "2.0.2",
  "private": true,
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "build:data": "node scripts/build-data.mjs",
    "build:search": "node scripts/build-search.mjs",
    "build:words": "node scripts/build-words.mjs",
    "icons:dark": "node scripts/generate-android-icons.mjs",
    "version:tag": "node scripts/version.mjs",
    "cap:sync": "npm run build && cap sync",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android",
    "cap:ios": "npm run build && cap sync ios && cap open ios",
    "cap:android": "npm run build && cap sync android && cap open android",
    "cap:apk": "npm run cap:sync && node scripts/gradle.mjs assembleRelease",
    "ios:build": "npm run build && cap sync ios && node scripts/ios-build.mjs",
    "preview": "npx --yes serve out"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capawesome/capacitor-file-picker": "^8.1.0",
    "@capgo/capacitor-speech-recognition": "^8.4.4",
    "minisearch": "^7.2.0",
    "motion": "^14.1.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "sharp@0.32.6": true,
    "sharp@0.35.5": true
  }
}
