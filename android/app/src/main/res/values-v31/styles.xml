<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ splash screen.

      The platform draws the splash itself from these attributes. Providing a
      VectorDrawable icon and an explicit background keeps the launch screen to
      a properly-proportioned centred icon on the app colour, instead of the
      platform falling back to rendering the app name over the window artwork.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowSplashScreenBackground">@color/splashBackground</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
        <item name="android:windowBackground">@color/splashBackground</item>
        <!-- Theme.SplashScreen's API 31+ variant drops the no-title flags that
             its pre-31 variant inherits, which left a platform title bar
             showing the activity label over the WebView. -->
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
    </style>
</resources>
