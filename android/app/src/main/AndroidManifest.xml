<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The Focus Lock's gate (FocusAccessibilityService).

             The service is exported because the system, not the app, binds it;
             BIND_ACCESSIBILITY_SERVICE is what keeps anything else out. It is
             declared with an intent filter so it appears in Android's
             accessibility settings — where the reader turns it on — and the
             metadata file beside it is the narrow set of events it may see
             (res/xml/focus_lock_service.xml). Nothing here blocks anything
             until both the reader has enabled the service and the lock is
             armed in the app. -->
        <service
            android:name=".FocusAccessibilityService"
            android:exported="true"
            android:label="@string/focus_lock_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/focus_lock_service" />
        </service>

        <!-- The update's download step (UpdateActivity). Transparent, because
             it has no screen of its own — the progress lives in the notification
             and the installer opens over it. Not in recents, and in a task of
             its own, so a tap on the update notification never leaves a blank
             activity behind in the app's history. It is not exported: the only
             way in is the PendingIntent the notification carries. -->
        <activity
            android:name=".UpdateActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/AppTheme.Update" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The update checker's three notifications (UpdateCheck): "Update
         available", the download's progress, and "ready to install". Android 13+
         treats a notification as a permission the reader grants; the app asks
         once, on first launch. The daily reminder's plugin declares this too —
         one permission, both features. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- "Install unknown apps": the update notification downloads an APK and
         hands it to Android's installer, which refuses to run for an app that
         has not been allowed to install packages. The app never grants this
         itself; it opens the system screen for it (UpdateActivity), and the
         reader decides. Without the permission the feature stops at a
         downloaded file and a "ready to install" notification. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Saving a favorites backup into Downloads needs shared storage on
         Android 9 and older; from API 29 on MediaStore writes it without any
         permission, so this is capped to where it is actually needed. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Dictation in the journal (see lib/dictation.ts) listens through the
         device's own speech recognizer, so the microphone is the one thing it
         needs. The query below is what makes the recognizer visible to the app
         on Android 11+, where a package has to declare the intents it looks
         for; without it `SpeechRecognizer` reports itself unavailable. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- The Focus page's app picker (FocusLockPlugin.listApps) lists the apps
             with a launcher icon. From Android 11 on, a package can only see the
             intents it declares here, so without this the picker would come back
             empty. Reading the list needs no permission of its own. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- The daily reminder (see lib/reminders.ts) never asks for an exact
         alarm: it schedules inexact ones on purpose, so the system can batch
         them and never opens the "Alarms & reminders" screen at the reader.
         The notifications plugin declares SCHEDULE_EXACT_ALARM for its own
         exact-alarm support, and Google Play restricts that permission to
         alarms and calendar apps — so it is dropped from the merged manifest
         rather than carried into the APK unused. POST_NOTIFICATIONS (Android
         13+), RECEIVE_BOOT_COMPLETED and WAKE_LOCK, which the reminder does
         need, come in with the plugin. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:node="remove" />
</manifest>
