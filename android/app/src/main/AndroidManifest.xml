<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Saving a favorites backup into Downloads needs shared storage on
         Android 9 and older; from API 29 on MediaStore writes it without any
         permission, so this is capped to where it is actually needed. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Dictation in the journal (see lib/dictation.ts) listens through the
         device's own speech recognizer, so the microphone is the one thing it
         needs. The query below is what makes the recognizer visible to the app
         on Android 11+, where a package has to declare the intents it looks
         for; without it `SpeechRecognizer` reports itself unavailable. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- The daily reminder (see lib/reminders.ts) never asks for an exact
         alarm: it schedules inexact ones on purpose, so the system can batch
         them and never opens the "Alarms & reminders" screen at the reader.
         The notifications plugin declares SCHEDULE_EXACT_ALARM for its own
         exact-alarm support, and Google Play restricts that permission to
         alarms and calendar apps — so it is dropped from the merged manifest
         rather than carried into the APK unused. POST_NOTIFICATIONS (Android
         13+), RECEIVE_BOOT_COMPLETED and WAKE_LOCK, which the reminder does
         need, come in with the plugin. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:node="remove" />
</manifest>
